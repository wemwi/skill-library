                                                "language": "javascript",
                                                "inputFormat": "editor",
                                                "codeEditorJavascript": "// ── Anlage prüfen ────────────────────────────────────────────────────────\nconst parse = (v) => (typeof v === 'string' ? (v ? JSON.parse(v) : null) : v);\n\nconst b     = parse(input.body) || {};\nconst st    = String(input.status || '');\nconst label = String(input.label || '');\nconst id    = String(b.id || '');\nconst exp   = String(b.expirationTime || '');\n\nif (!id) {\n  const err = b.error ? JSON.stringify(b.error) : JSON.stringify(b).slice(0, 500);\n  return {\n    ok: 'no',\n    text: '\\u26d4 <b>Airtable-Webhook konnte nicht angelegt werden: ' + label + '</b>\\nHTTP ' + st + '\\n' + err\n  };\n}\n\nconst hatSecret = b.macSecretBase64 ? 'ja' : 'nein';\n\nreturn {\n  ok: 'yes',\n  text: '\\u2705 <b>Airtable-Webhook registriert: ' + label + '</b>\\n' +\n        'webhookId: ' + id + '\\n' +\n        'g\\u00fcltig bis: ' + exp + '\\n' +\n        'Scope: ' + String(input.feldzahl || '?') + ' gelauschte Felder\\n' +\n        'macSecret im Laufergebnis: ' + hatSecret +\n        ' \\u2014 jetzt sichern, Airtable gibt es nie wieder aus.'\n};\n"
                                            },
