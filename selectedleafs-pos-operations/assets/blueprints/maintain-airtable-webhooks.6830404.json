                ],
                "language": "javascript",
                "inputFormat": "editor",
                "dependencies": [],
                "codeEditorJavascript": "// ── Modul 2 · Soll-Ist-Abgleich über ALLE Hooks ──────────────────────────\n// Traegt die Registrierungs-Liste. Ein neuer Airtable-Webhook wird hier\n// eingetragen, sonst nirgends — der Rest des Szenarios ist generisch.\n//\n// Der Abgleich laeuft ueber die notificationUrl: so findet das Szenario\n// seine eigenen Hooks auch dann, wenn in der Base weitere existieren.\n//\n// changeTypes ist optional je SOLL-Eintrag: ist es gesetzt, geht es in die\n// Spec; fehlt es, gilt Airtables Default (add + remove + update). Aktuell\n// setzt nur der Belegeingang es explizit (['add'], damit ausschliesslich die\n// Neuanlage feuert und kein spaeteres 'update' — insbesondere die\n// Anhang-Ersetzung durch das Fachszenario — einen zweiten Lauf ausloest).\n// Stores/Vertriebler laufen auf dem Default. Wer 'remove' auch dort\n// raushaben will: changeTypes am jeweiligen Eintrag ergaenzen.\n//\n// WICHTIG zu watchDataInFieldIds: die Felder, die MAKE ZURUECKSCHREIBT\n// (⚙ Lexware ID, ⚙ Shopify GID, ⚙ Hinweis, Belegeingang: Typ), duerfen hier\n// NICHT stehen. Sonst loest der eigene Write-Back den Hook erneut aus.\n\nconst SOLL = [\n  {\n    label: 'Stores Inbox',\n    hookUrl: 'https://hook.eu1.make.com/qyd8gsmbjnvn438re5ke3iu4lo42h6n1',\n    scope: 'viwznNQSsw8hnOH1a',\n    // Stores: die 12 Formularfelder. Ohne ⚙ Shopify GID (Write-Back).\n    fields: [\n      'fld7fbRS1BHvrqJrj', // Name\n      'fldJzdkest3PwK2y6', // Postleitzahl\n      'fld3qcSSGz8Y6M3zx', // Straße / Nr.\n      'fldhtzwUV5qXTs8BY', // Bild\n      'fldA81gIXLtI9ZT3C', // Sortiment\n      'fldTTMLi9aaL9kVa0', // Paketdienste\n      'fld6abb6WVqH9i5Qi', // Telefon\n      'fld1CzHQpAmfTPUIz', // WhatsApp\n      'fldsVzi4cb6TQkMx3', // Instagram\n      'fldPDxmOBmKYcjxZl', // Facebook\n      'fldzYuBjs6Cd5QHKo', // TikTok\n      'fldxV6Leoj4wmures'  // Webseite\n    ]\n  },\n  {\n    label: 'Vertriebler Inbox',\n    hookUrl: 'https://hook.eu1.make.com/x7bi3ee643uvgmvhs5egpqs4smlq5byd',\n    scope: 'viwBdLeiPCMzEcQi6',\n    // Vertriebler: die 6 Stammfelder. Ohne ⚙ Lexware ID und ⚙ Hinweis\n    // (beides Write-Back von Create Salesperson).\n    fields: [\n      'fldhDp2HHI6BxjlZq', // Name\n      'fldnwZ7yZ8A8B5yGt', // Straße / Nr.\n      'fldvsm8IZnzVQWJae', // Postleitzahl\n      'fldTfEX0YglBq8alh', // Ort\n      'fldBcufVGhXAdxJHS', // Besteuerung\n      'fldF4idsFUiCgAX1A'  // ⚙ Regelbesteuerung ab\n    ]\n  },\n  {\n    label: 'Belegeingang',\n    hookUrl: 'https://hook.eu1.make.com/f1jzbqgxwinikpfjqe03tt4ndxl96vkq',\n    scope: 'viwrTpIitbxzfh9l5',\n    // Scope ist die View 'Inbox (make.com)', NICHT die Tabelle.\n    //\n    // changeTypes = ['add']: es feuert AUSSCHLIESSLICH, wenn ein Beleg NEU in\n    // die View kommt (= der Upload; die Formularanlage setzt den Anhang atomar\n    // mit). Jedes spaetere 'update' bleibt komplett draussen — insbesondere:\n    //   - der Typ-Writeback des Dispatchers (Record verlaesst die View), und\n    //   - das Ersetzen des Anhangs durch das Fachszenario.\n    // Beide kamen mit 'update' als zweiter, leerer Lauf je Upload an (Phantom).\n    //\n    // Preis: eine Handkorrektur holt einen Problem-Beleg nur dann zurueck,\n    // wenn dabei ein echtes View-Wiedereintritt-'add' entsteht; Recovery eines\n    // haengenden/gestorbenen Belegs laeuft ohnehin ueber DLQ-Replay.\n    changeTypes: ['add'],\n    fields: [\n      'fldd3wi6dceGmnppx'  // Beleg (Anhang) — setzt das 'add' scharf\n    ]\n  }\n];\n\nconst parse = (v) => (typeof v === 'string' ? (v ? JSON.parse(v) : null) : v);\n\nconst body  = parse(input.body) || {};\nconst st    = String(input.status || '');\nconst hooks = body.webhooks || [];\n\nif (st !== '200') {\n  return {\n    error: 'yes',\n    httpStatus: st,\n    rohantwort: JSON.stringify(body).slice(0, 600),\n    hooks: []\n  };\n}\n\nconst out = [];\n\nfor (let i = 0; i < SOLL.length; i++) {\n  const soll = SOLL[i];\n\n  const filters = {\n    dataTypes: ['tableData'],\n    recordChangeScope: soll.scope,\n    watchDataInFieldIds: soll.fields\n  };\n  if (soll.changeTypes) {\n    filters.changeTypes = soll.changeTypes;\n  }\n\n  const spec = {\n    notificationUrl: soll.hookUrl,\n    specification: {\n      options: {\n        filters: filters\n      }\n    }\n  };\n\n  const mine = hooks.filter(\n    (h) => String(h.notificationUrl || '') === soll.hookUrl\n  )[0];\n\n  if (!mine) {\n    out.push({\n      label: soll.label,\n      action: 'create',\n      hookUrl: soll.hookUrl,\n      // Fertiger JSON-STRING. Eine verschachtelte Collection reicht Make dem\n      // HTTP-Modul nicht als JSON hinaus.\n      createBody: JSON.stringify(spec),\n      refreshUrl: '',\n      webhookId: '',\n      enabled: '',\n      lastOk: '',\n      feldzahl: String(soll.fields.length)\n    });\n    continue;\n  }\n\n  const id = String(mine.id || '');\n  out.push({\n    label: soll.label,\n    action: 'refresh',\n    hookUrl: soll.hookUrl,\n    createBody: '',\n    refreshUrl: 'https://api.airtable.com/v0/bases/' + String(input.baseId || '') +\n                '/webhooks/' + id + '/refresh',\n    webhookId: id,\n    enabled: (mine.isHookEnabled && mine.areNotificationsEnabled) ? 'yes' : 'no',\n    lastOk: String(mine.lastSuccessfulNotificationTime || 'noch nie'),\n    feldzahl: String(soll.fields.length)\n  });\n}\n\nreturn {\n  error: 'no',\n  httpStatus: st,\n  rohantwort: '',\n  hooks: out\n};"
            },
