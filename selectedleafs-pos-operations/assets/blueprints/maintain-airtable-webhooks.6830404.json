                                                "language": "javascript",
                                                "inputFormat": "editor",
                                                "codeEditorJavascript": "// ── Refresh prüfen ───────────────────────────────────────────────────────\n// Der taegliche Lauf meldet sich nur, wenn etwas nicht stimmt.\n\nconst parse = (v) => (typeof v === 'string' ? (v ? JSON.parse(v) : null) : v);\n\nconst b     = parse(input.body) || {};\nconst st    = String(input.status || '');\nconst exp   = String(b.expirationTime || '');\nconst id    = String(input.webhookId || '');\nconst label = String(input.label || '');\n\nconst probleme = [];\n\nif (st !== '200') {\n  const err = b.error ? JSON.stringify(b.error) : JSON.stringify(b).slice(0, 300);\n  probleme.push('Verl\\u00e4ngerung fehlgeschlagen (HTTP ' + st + '): ' + err);\n} else if (!exp) {\n  probleme.push('Airtable hat keine neue expirationTime geliefert.');\n}\n\nif (String(input.enabled || '') === 'no') {\n  probleme.push('Der Webhook ist bei Airtable deaktiviert. Solange das so ist, ' +\n                'kommen von dieser Inbox keine Anlagen mehr an.');\n}\n\nif (!probleme.length) {\n  return { alarm: 'no', text: '' };\n}\n\nreturn {\n  alarm: 'yes',\n  text: '\\u26a0\\ufe0f <b>Airtable-Webhook: Problem beim Refresh \\u2014 ' + label + '</b>\\n' +\n        'webhookId: ' + id + '\\n' +\n        'letzte erfolgreiche Zustellung: ' + String(input.lastOk || 'unbekannt') + '\\n\\n' +\n        probleme.join('\\n') + '\\n\\n' +\n        'Ohne g\\u00fcltigen Webhook l\\u00e4uft das zugeh\\u00f6rige Anlage-Szenario nicht mehr an.'\n};\n"
                                            },
