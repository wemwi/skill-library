                "language": "javascript",
                "inputFormat": "editor",
                "dependencies": [],
                "codeEditorJavascript": "function mapPlace(place){ const oh=place.regularOpeningHours; if(!(oh&&Array.isArray(oh.periods)&&oh.periods.length>0)) return null; const hasCount=typeof place.userRatingCount==='number'&&place.userRatingCount>0; const f={opening_hours:{regular:place.regularOpeningHours,current:place.currentOpeningHours??null},rating_count:hasCount?place.userRatingCount:0}; if(hasCount&&typeof place.rating==='number') f.rating={scale_min:'1.0',scale_max:'5.0',value:String(place.rating)}; if(typeof place.nationalPhoneNumber==='string'&&place.nationalPhoneNumber.length>0) f.phone=place.nationalPhoneNumber; if(typeof place.websiteUri==='string'&&place.websiteUri.length>0) f.website=place.websiteUri; return f; }\nfunction deepEqual(a,b){ if(a===b) return true; if(typeof a!==typeof b) return false; if(a===null||b===null) return a===b; if(Array.isArray(a)||Array.isArray(b)){ if(!Array.isArray(a)||!Array.isArray(b)||a.length!==b.length) return false; for(let i=0;i<a.length;i++) if(!deepEqual(a[i],b[i])) return false; return true;} if(typeof a==='object'&&typeof b==='object'){ const ak=Object.keys(a),bk=Object.keys(b); if(ak.length!==bk.length) return false; for(const k of ak){ if(!Object.prototype.hasOwnProperty.call(b,k)) return false; if(!deepEqual(a[k],b[k])) return false;} return true;} return false; }\nfunction parseJson(v){ if(v===null||v===undefined) return undefined; try{ return JSON.parse(v); }catch{ return undefined; } }\nfunction jsonEqual(cur,des){ const p=parseJson(cur); if(p===undefined) return false; return deepEqual(p,des); }\nfunction nonEmptyVal(cur){ return cur!==null&&cur!==undefined&&String(cur).trim()!==''; }\nfunction numberEqual(cur,des){ if(!nonEmptyVal(cur)) return false; const n=Number(cur); return Number.isFinite(n)&&n===des; }\nfunction ratingValueEqual(cur,desVal){ const p=parseJson(cur); if(p===null||typeof p!=='object'||p===undefined) return false; const c=p.value; if(typeof c!=='string'&&typeof c!=='number') return false; const a=Number(c),b=Number(desVal); return Number.isFinite(a)&&Number.isFinite(b)&&a===b; }\n// GUARD phone/website: nie leeren, nur aktualisieren. Beide Felder haben eine menschliche\n// Quelle (Airtable-Formular) und werden vom Create-Szenario als Fallback gesetzt. Liefert\n// Places keinen Wert, bleibt der bestehende stehen — KEIN Leer-Write. rating behaelt seinen\n// Leer-Zweig bewusst (rein maschinelle Quelle). Diese beiden else-Zweige nicht wieder einbauen.\nfunction diffFields(current,mapped){ const w=[]; if(!jsonEqual(current.opening_hours,mapped.opening_hours)) w.push({key:'opening_hours',value:JSON.stringify(mapped.opening_hours)}); if(!numberEqual(current.rating_count,mapped.rating_count)) w.push({key:'rating_count',value:String(mapped.rating_count)}); if(mapped.rating!==undefined){ if(!ratingValueEqual(current.rating,mapped.rating.value)) w.push({key:'rating',value:JSON.stringify(mapped.rating)});} else if(nonEmptyVal(current.rating)) w.push({key:'rating',value:''}); if(mapped.phone!==undefined){ if(current.phone!==mapped.phone) w.push({key:'phone',value:mapped.phone});} if(mapped.website!==undefined){ if(current.website!==mapped.website) w.push({key:'website',value:mapped.website});} return w; }\n// Report-Normalisierung: regular.openNow + regular.nextCloseTime sind zeitabhaengig,\n// current rotiert woechentlich (periods[].date). Beides fuer den Report ausblenden —\n// geschrieben wird trotzdem, damit current nicht veraltet.\nfunction stableOpeningHours(oh){ if(oh===null||oh===undefined||typeof oh!=='object') return null; const r=oh.regular; if(r===null||r===undefined||typeof r!=='object') return { regular:null }; const s={}; for(const k of Object.keys(r)) if(k!=='openNow'&&k!=='nextCloseTime') s[k]=r[k]; return { regular:s }; }\nfunction reportKeysFrom(writes,current,mapped){ return writes.filter(function(w){ if(w.key!=='opening_hours') return true; return !deepEqual(stableOpeningHours(parseJson(current.opening_hours)), stableOpeningHours(mapped.opening_hours)); }).map(function(w){ return w.key; }); }\nfunction isNew(nf,c,now,th){ if(nf!=='true') return false; const t=Date.parse(c); return !Number.isNaN(t) && now-t > th*86400000; }\nconst { placesData, hasPlaceId, id, handle, createdAt, newFlag, cur_opening_hours, cur_rating, cur_rating_count, cur_phone, cur_website } = input;\nconst current = { opening_hours: cur_opening_hours ?? null, rating: cur_rating ?? null, rating_count: cur_rating_count ?? null, phone: cur_phone ?? null, website: cur_website ?? null };\nconst resetNew = isNew(newFlag, createdAt, Date.now(), 45) ? '1' : '';\nlet placesBucket, reason='', placesWrites=[], reportKeys=[];\nif(hasPlaceId!=='1' || !placesData){ placesBucket='skipped'; reason='kein google_place / keine Place ID'; }\nelse { const mapped=mapPlace(placesData);\n  if(mapped===null){ placesBucket='skipped'; reason='keine regulären Öffnungszeiten'; }\n  else { placesWrites=diffFields(current,mapped); reportKeys=reportKeysFrom(placesWrites,current,mapped); placesBucket=reportKeys.length?'updated':'unchanged'; } }\nconst allWrites = (resetNew==='1'?[{key:'new',value:'false'}]:[]).concat(placesWrites);\nreturn { id, handle, placesBucket, reason, placesKeysStr: reportKeys.join(', '), resetNew, hasWrites: allWrites.length?'1':'', variablesJson: JSON.stringify({ id, fields: allWrites }) };"
