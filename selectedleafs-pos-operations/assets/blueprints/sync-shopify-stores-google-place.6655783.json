                "language": "javascript",
                "inputFormat": "editor",
                "codeEditorJavascript": "function nonEmpty(v){ return typeof v==='string' && v.trim().length>0; }\nconst { items } = input;\nconst list = Array.isArray(items) ? items : [];\nconst L=['✅ POS-Sync',''];\nL.push('Stores: '+list.length);\nconst upd=list.filter(x=>x.placesBucket==='updated');\nconst skp=list.filter(x=>x.placesBucket==='skipped');\nconst nr=list.filter(x=>x.resetNew==='1');\nL.push('Stammdaten — aktualisiert: '+upd.length+' · unverändert: '+list.filter(x=>x.placesBucket==='unchanged').length+' · übersprungen: '+skp.length);\nif(upd.length){ L.push('','Stammdaten:'); for(const u of upd) L.push('• '+u.handle+': '+(u.placesKeysStr||'')); }\nif(skp.length){ L.push('','Stammdaten übersprungen:'); for(const x of skp) L.push('• '+x.handle+': '+x.reason); }\nif(nr.length){ L.push('','Neu-Flag zurückgesetzt:'); for(const n of nr) L.push('• '+n.handle); }\nconst failed=list.filter(x=>nonEmpty(x.errors));\nif(failed.length){ L.push('','⚠️ Shopify-Fehler:'); for(const f of failed) L.push('• '+f.handle+': '+f.errors); }\n// Zaehlwerte + gedeckelter Zeilenblock fuer die Landkarten-Vorlage\n// sync.stores, fertig als ctx-JSON (der Block traegt Zeilenumbrueche).\nconst zeilen = upd.slice(0, 10).map(u => u.handle + ': ' + (u.placesKeysStr || ''));\nif (upd.length > 10) zeilen.push('… und ' + (upd.length - 10) + ' weitere');\nreturn {\n  text: L.join('\\n'),\n  ctx: JSON.stringify({\n    n: String(list.length), m: String(upd.length), Zeilen: zeilen.join('\\n')\n  })\n};"
