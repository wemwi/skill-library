{
    "name": "[Sync] JTL Invoice to Lexware",
    "flow": [
        {
            "id": 3,
            "module": "gateway:CustomMailHook",
            "version": 1,
            "parameters": {
                "hook": 3515578,
                "maxResults": 1
            },
            "mapper": {},
            "metadata": {
                "designer": {
                    "x": 0,
                    "y": 0
                },
                "restore": {
                    "parameters": {
                        "hook": {
                            "data": {
                                "editable": "false"
                            },
                            "label": "Invoice to Lexware"
                        }
                    }
                },
                "parameters": [
                    {
                        "name": "hook",
                        "type": "hook:gateway-mailhook",
                        "label": "Mailhook",
                        "required": true
                    },
                    {
                        "name": "maxResults",
                        "type": "number",
                        "label": "Maximum number of results"
                    }
                ]
            }
        },
        {
            "id": 6,
            "module": "code:ExecuteCode",
            "version": 1,
            "parameters": {},
            "mapper": {
                "input": [
                    {
                        "name": "namen",
                        "value": "{{map(3.attachments; \"fileName\")}}"
                    },
                    {
                        "name": "typen",
                        "value": "{{map(3.attachments; \"contentType\")}}"
                    }
                ],
                "language": "javascript",
                "inputFormat": "editor",
                "dependencies": [],
                "codeEditorJavascript": "// Waehlt aus den Anhaengen EIN Dokument aus.\n//\n// Warum ueberhaupt eine Auswahl: Stripe-Absender (Figma, Webflow, ...) haengen\n// pro Mail zwei PDFs an - Invoice UND Receipt. Beide beschreiben dieselbe\n// Zahlung; beide hochzuladen erzeugt zwei Belege fuer einen Vorgang.\n//\n// Warum eine Vorzugsliste statt einer Ausschlussliste: \"receipt\" auszuschliessen\n// waere eine Blacklist, die beim naechsten Anbieter mit anderer Wortwahl bricht.\n// Die Wortliste unten ist eine POSITIVE Praeferenz - greift sie nicht, faellt es\n// auf \"erstes PDF\" zurueck. Dateien wie RG-10113-1.pdf oder dogado_2026.pdf\n// laufen dadurch unveraendert durch.\n//\n// Bewusste Schwaeche: bei zwei PDFs ohne Rechnungswort entscheidet die\n// Reihenfolge, also der Zufall. Das ist der Preis dafuer, nie zwei Belege fuer\n// eine Zahlung zu erzeugen.\n//\n// Es laufen NUR Dateinamen und MIME-Typen durch dieses Modul, keine Puffer -\n// die Binaerdaten bleiben im Iterator.\n\nvar arr = function (v) {\n  if (Array.isArray(v)) return v;\n  if (typeof v === \"string\" && v.trim()) {\n    try { var p = JSON.parse(v); return Array.isArray(p) ? p : []; } catch (e) { return []; }\n  }\n  return [];\n};\nvar txt = function (v) { return String(v == null ? \"\" : v); };\n\nvar namen = arr(input.namen).map(txt);\nvar typen = arr(input.typen).map(function (v) { return txt(v).toLowerCase(); });\n\n// PDF-Erkennung doppelt abgesichert: ueber den MIME-Typ ODER die Endung.\n// Manche Absender deklarieren PDFs als application/octet-stream.\nvar kandidaten = [];\nfor (var i = 0; i < namen.length; i++) {\n  var name = namen[i];\n  var typ = typen[i] || \"\";\n  if (typ.indexOf(\"pdf\") === -1 && name.toLowerCase().indexOf(\".pdf\") === -1) continue;\n  kandidaten.push(name);\n}\n\nif (kandidaten.length === 0) return { pick: \"\", anzahl: 0, grund: \"kein PDF im Anhang\" };\nif (kandidaten.length === 1) return { pick: kandidaten[0], anzahl: 1, grund: \"einziges PDF\" };\n\nvar woerter = [\"invoice\", \"rechnung\", \"facture\", \"factura\", \"fattura\"];\nfor (var w = 0; w < woerter.length; w++) {\n  for (var k = 0; k < kandidaten.length; k++) {\n    if (kandidaten[k].toLowerCase().indexOf(woerter[w]) !== -1) {\n      return { pick: kandidaten[k], anzahl: kandidaten.length, grund: \"Rechnungswort '\" + woerter[w] + \"' im Dateinamen\" };\n    }\n  }\n}\n\nreturn { pick: kandidaten[0], anzahl: kandidaten.length, grund: \"mehrere PDFs, kein Rechnungswort - erstes genommen\" };\n"
            },
            "metadata": {
                "designer": {
                    "x": 300,
                    "y": 0,
                    "name": "Dokument wählen"
                }
            }
        },
        {
            "id": 4,
            "module": "builtin:BasicFeeder",
            "version": 1,
            "parameters": {},
            "mapper": {
                "array": "{{3.attachments}}"
            },
            "metadata": {
                "designer": {
                    "x": 600,
                    "y": 0
                }
            }
        },
        {
            "id": 5,
            "module": "lexoffice:uploadAnImageDocument",
            "version": 1,
            "parameters": {
                "__IMTCONN__": 9622667
            },
            "filter": {
                "name": "Nur das gewählte PDF",
                "conditions": [
                    [
                        {
                            "a": "{{6.result.pick}}",
                            "o": "exist"
                        },
                        {
                            "a": "{{4.fileName}}",
                            "b": "{{6.result.pick}}",
                            "o": "text:equal"
                        }
                    ]
                ]
            },
            "mapper": {
                "data": "{{4.data}}",
                "type": "voucher",
                "filename": "{{4.fileName}}"
            },
            "metadata": {
                "designer": {
                    "x": 900,
                    "y": 0
                },
                "restore": {
                    "expect": {
                        "type": {
                            "mode": "chose",
                            "label": "Voucher"
                        }
                    },
                    "parameters": {
                        "__IMTCONN__": {
                            "data": {
                                "scoped": "true",
                                "connection": "lexoffice"
                            },
                            "label": "Lexware · Invoice to Lexware (joscha@wemwi.de)"
                        }
                    }
                },
                "parameters": [
                    {
                        "name": "__IMTCONN__",
                        "type": "account:lexoffice",
                        "label": "Connection",
                        "required": true
                    }
                ],
                "expect": [
                    {
                        "name": "type",
                        "type": "select",
                        "label": "Document Type",
                        "required": true,
                        "validate": {
                            "enum": [
                                "voucher",
                                "attachment"
                            ]
                        }
                    },
                    {
                        "name": "filename",
                        "type": "filename",
                        "label": "File Name",
                        "required": true,
                        "extension": [
                            "jpg",
                            "pdf",
                            "png"
                        ]
                    },
                    {
                        "name": "data",
                        "type": "buffer",
                        "label": "Data",
                        "required": true
                    }
                ]
            }
        }
    ],
    "metadata": {
        "instant": true,
        "version": 1,
        "scenario": {
            "roundtrips": 1,
            "maxErrors": 3,
            "autoCommit": true,
            "autoCommitTriggerLast": true,
            "sequential": false,
            "slots": null,
            "confidential": false,
            "dataloss": false,
            "dlq": true,
            "freshVariables": false
        },
        "designer": {
            "orphans": []
        },
        "zone": "eu1.make.com",
        "notes": []
    }
}